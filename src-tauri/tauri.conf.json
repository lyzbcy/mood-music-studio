{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Mood Music Studio",
  "version": "0.0.1",
  "identifier": "com.lyzbcy.mood-music-studio",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Mood Music Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Music/**", "$DOCUMENT/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 泽恩 (lyzbcy)",
    "category": "Music",
    "shortDescription": "音乐自动打标签 + AI 分镜配乐",
    "longDescription": "给音乐打情绪/场景标签，用分镜提示词智能检索最适合的配乐和音效。"
  }
}
